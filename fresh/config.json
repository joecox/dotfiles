{
  "$schema": "https://raw.githubusercontent.com/sinelaw/fresh/refs/heads/master/crates/fresh-editor/plugins/config-schema.json",
  "version": 3,
  "theme": "default.json",
  "editor": {
    "show_vertical_scrollbar": false,
    "show_horizontal_scrollbar": false,
    "confirm_quit": true,
    "completion_popup_auto_show": true,
    "cursor_jump_animation": false
  },
  "file_browser": {
    "show_hidden": true
  },
  "file_explorer": {
    "width": "20%",
    "show_hidden": true
  },
  "plugins": {
    "welcome_screen": {
      "settings": {
        "showOnStartup": false
      },
      "enabled": true
    },
    "orchestrator": {
      "enabled": false
    },
    "vi_mode": {
      "enabled": false
    }
  },
  "languages": {
    "mise-toml": {
      "extensions": [],
      "filenames": [
        "mise.toml",
        ".mise.toml",
        "mise.*.toml",
        ".mise.*.toml",
        "**/mise/config.toml",
        "**/mise/config.*.toml",
        "**/.mise/config.toml",
        "**/.mise/config.*.toml",
        "**/mise/conf.d/*.toml",
        "**/.mise/conf.d/*.toml"
      ],
      "grammar": "toml",
      "comment_prefix": "#",
      "auto_indent": true
    }
  },
  "lsp": {
    "json": {
      "enabled": false,
      "auto_start": false
    },
    "jsonc": {
      "enabled": false,
      "auto_start": false
    },
    "typescript": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "auto_start": true
    },
    "toml": {
      "command": "taplo",
      "args": ["lsp", "stdio"],
      "enabled": true,
      "auto_start": true
    },
    "mise-toml": {
      "command": "mise",
      "args": ["lsp"],
      "enabled": true,
      "auto_start": true,
      "language_id_overrides": {
        "toml": "toml"
      }
    }
  },
  "active_keybinding_map": "emacs"
}
